{
  "name": "local-ai-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "test:server": "node --import tsx --test tests/server/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "preview:lan": "vite preview --host 0.0.0.0 --port 5173",
    "start": "tsx server/index.ts",
    "start:public": "node scripts/run-public.mjs",
    "sync:launchers": "node scripts/sync-launchers.mjs",
    "start:public:zrok": "node scripts/run-public-zrok.mjs",
    "share:localtunnel": "node scripts/run-public.mjs",
    "share:zrok": "node scripts/run-zrok-share.mjs",
    "stress:public": "node scripts/stress-reload-check.mjs",
    "portable:check": "node scripts/portable-launch.mjs --check",
    "portable:dev": "node scripts/portable-launch.mjs --dev",
    "portable:lan": "node scripts/portable-launch.mjs --lan",
    "test:portable": "node --test --test-isolation=none tests/portable/portable-core.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "license": "MIT"
}
